{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redrise.diagnostic/1",
  "title": "RedRise diagnostic (docs/ERROR-DIAGNOSTICS.md)",
  "type": "object",
  "required": ["schema", "error_code", "category", "what_happened", "completed", "pending", "effect_state", "next_action",
               "retry", "details_summary", "reported_by", "module_hints", "diagnosis_status", "correlation_id"],
  "properties": {
    "schema": {"const": "redrise.diagnostic/1"},
    "error_code": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "category": {"enum": ["module_internal", "contract", "communication", "environment", "precondition", "unknown"]},
    "what_happened": {"type": "string", "minLength": 1},
    "completed": {"type": "string", "minLength": 1},
    "pending": {"type": "string", "minLength": 1},
    "effect_state": {"enum": ["none", "partial", "confirmed", "unknown"]},
    "next_action": {"type": "string", "minLength": 1},
    "retry": {"enum": ["safe", "after_fix", "check_first", "not_useful"]},
    "details_summary": {"type": "string", "minLength": 1},
    "reported_by": {"type": "string", "pattern": "^RR-[A-Z-]+$"},
    "module_hints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RR-[A-Z-]+$"}},
    "diagnosis_status": {"enum": ["confirmed", "suggested", "unconfirmed"]},
    "boundary": {"type": ["object", "null"], "properties": {"producer": {"type": "string"}, "consumer": {"type": "string"}, "contract": {"type": "string"}}},
    "correlation_id": {"type": "string", "minLength": 1},
    "version": {"type": "object"},
    "technical_details": {"type": "object", "description": "sanitized: no secrets, argv, environment or personal profile paths"},
    "params": {"type": "object", "additionalProperties": {"type": "string"}, "description": "sanitized placeholder values; the UI locale mask renders its own texts from error_code + params"},
    "cause": {"oneOf": [{"type": "null"}, {"$ref": "#"}]}
  },
  "additionalProperties": false
}
