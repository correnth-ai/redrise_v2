{
  "name": "redrise-desktop",
  "private": true,
  "version": "0.1.0-beta.17",
  "type": "module",
  "description": "RedRise desktop UI (React + TypeScript, shadcn/ui primitives, Vite as build-only bundler) inside Tauri",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:ui": "tsc -p tsconfig.json --noEmit && vite build && node scripts/copy-static.mjs",
    "dev:demo": "node scripts/copy-static.mjs public && vite --mode demo",
    "tauri": "tauri"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
